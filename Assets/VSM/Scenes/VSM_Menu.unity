  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u043E \u0431\u0438\u043B\u0435\u0442\u0443 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440
    3\u0411 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u043B \u0441\u043E\u0439\u0442\u0438
    \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u0441\u0442\u0430\u043D\u0446\u0438\u0438,
    \u043C\u0435\u0441\u0442\u043E \u043F\u0443\u0441\u0442\u043E\u0435, \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C:
    \xAB\u0432\u044B\u0445\u043E\u0434\u0438\u043B \u0441 \u0447\u0435\u043C\u043E\u0434\u0430\u043D\u043E\u043C,
    \u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0441\u044F\xBB. \u041F\u043E\u0438\u0441\u043A
    \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u0432\u0430\u0433\u043E\u043D\u0430\u0445
    \u043F\u0443\u0441\u0442. \u0412\u0435\u0449\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F
    \u041F\u0422\u0411 \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438, \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446
    \u043F\u043E\u0442\u043E\u043C \u0438\u0449\u0435\u0442 \u0435\u0451 \u0447\u0435\u0440\u0435\u0437
    \u0432\u043E\u043A\u0437\u0430\u043B."
