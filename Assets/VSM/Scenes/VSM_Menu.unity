  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u0430\u0441\u0441\u0430\u0436\u0438\u0440 3\u0412 \u0435\u0434\u0435\u0442
    \u0434\u043E \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439: \u0431\u0438\u043B\u0435\u0442
    \u044D\u0442\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442,
    \u043D\u0430 \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0435 \u043A\u0443\u0440\u0442\u043A\u0430
    \u0438 \u0433\u0430\u0437\u0435\u0442\u0430, \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C
    \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u043E\u043D \u0443\u0448\u0451\u043B
    \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0432\u043E\u0441\u044C\u043C\u043E\u0433\u043E
    \u0432\u0430\u0433\u043E\u043D\u0430. \u0412\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
    \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043F\u043E \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044E
    \u0441\u0440\u0435\u0434\u0438 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432
    \u0432\u0430\u0433\u043E\u043D\u0430 8 (\u0434\u0432\u043E\u0435 \u043F\u043E\u0445\u043E\u0436\u0438\u0445)
    \u0438\u043B\u0438 \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F."
  m_isRightToLeft: 0
