  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 3\u0411 \u0441\u043E\u0448\u0451\u043B
    \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0432\u0435\u0449\u0430\u043C\u0438,
    \u0430 \u0441\u0443\u043C\u043A\u0443 \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430
    \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043A\u0430 1\u0410, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
    \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0438 \u0443\u0448\u043B\u0430 \u0437\u0430
    \u043A\u043E\u0444\u0435. \u0415\u0451 \u0432\u044B\u0434\u0430\u0451\u0442 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C
    \u0438 \u0431\u0438\u043B\u0435\u0442 1\u0410; \u043E\u0431\u0449\u0435\u0435
    \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0435\u0451 \u0441\u0440\u0430\u0437\u0443, \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435
    \xAB\u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0430 \u0441 3\u0411\xBB
    \u2014 \u043D\u0435\u0442."
