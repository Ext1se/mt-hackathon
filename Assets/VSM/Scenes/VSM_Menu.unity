      m_Calls: []
  m_text: "\u0411\u0435\u0441\u0445\u043E\u0437\u043D\u044B\u0439 \u0440\u044E\u043A\u0437\u0430\u043A
    \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
    \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0431\u043E\u043B\u0435\u0435 \u043F\u0440\u043E\u0434\u0443\u043C\u0430\u043D\u043D\u044B\u0445
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0438 \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u041F\u0422\u0411.\n\n<size=14>* \u041F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430
    \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u044F, \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
    \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0439 - \u0432 \u0440\u0430\u0431\u043E\u0442\u0435.
    \u041D\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u043C\u043E\u0436\u043D\u043E
    \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u0443\u0436\u0435.</size>"
  m_isRightToLeft: 0
