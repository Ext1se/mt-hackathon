  m_text: "\u041F\u0435\u0440\u0432\u0430\u044F \u0440\u0435\u0430\u043A\u0446\u0438\u044F,
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u043E\u043C\u043E\u0449\u0438,
