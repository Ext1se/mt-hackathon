  m_text: "\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C,
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0430\u043D\u0438\u043A\u043E\u0439,
    \u043F\u043E\u0438\u0441\u043A \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430,
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0441 \u0444\u0430\u043A\u0442\u0430\u043C\u0438.
    \u0427\u0435\u0442\u044B\u0440\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F: \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446
    \u0443\u0448\u0451\u043B \u043A \u0434\u0440\u0443\u0437\u044C\u044F\u043C, \u0437\u0430\u0431\u044B\u043B
    \u0432\u0435\u0449\u044C, \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043D\u0430\u0440\u043E\u0447\u043D\u043E
    \u0438\u043B\u0438 \u0441\u043E\u0441\u0435\u0434\u043A\u0430 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u0430
    \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432."
