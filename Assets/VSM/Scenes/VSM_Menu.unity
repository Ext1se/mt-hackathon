      m_Calls: []
  m_text: "\u041F\u0430\u0441\u0441\u0430\u0436\u0438\u0440 \u0441\u043E\u0448\u0451\u043B,
    \u0430 \u043F\u0435\u0440\u0435\u0434 \u0441\u0442\u0430\u043D\u0446\u0438\u0435\u0439
    \u0441\u0430\u043C \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u043B \u0441\u0443\u043C\u043A\u0443
    \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0435 \u043A\u0440\u0435\u0441\u043B\u043E
    \u0438 \u0432\u044B\u0448\u0435\u043B \u043D\u0430\u043B\u0435\u0433\u043A\u0435
    \u2014 \u044D\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0438 \u0438 3\u0413,
    \u0438 4\u0412. \u041F\u0422\u0411 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442
    \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043E\u0432 \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439
    \u0432\u0430\u0433\u043E\u043D, \u0432\u0435\u0449\u044C \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F
    \u043F\u043E\u043B\u0438\u0446\u0438\u0438, \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446
    \u0435\u0451 \u043D\u0435 \u0438\u0449\u0435\u0442."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: bd371d315c2882d448cbd8e73fc308c8, type: 2}
