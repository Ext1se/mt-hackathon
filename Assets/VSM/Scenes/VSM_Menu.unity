  m_text: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F (\u0432\u0435\u0441\u0430: A
    35 %, B 25 %, C 15 %, D 25 %). \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C,
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0430\u043D\u0438\u043A\u043E\u0439,
