    \u0430\u0442\u0430\u043A\u0430 \u2014 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u0435,
    \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C."
