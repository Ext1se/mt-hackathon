    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u043E\u043C\u043E\u0449\u0438,
    \u0440\u0430\u0431\u043E\u0442\u0430 \u0441 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C\u0438.
    \u0421\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u0439 \u043F\u0440\u0438\u0441\u0442\u0443\u043F
