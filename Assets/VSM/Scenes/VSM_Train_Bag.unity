  _scenario: {fileID: 4900000, guid: 0ea5e9a2d66aa9245b289a1ed94fd955, type: 3}
  _startHint: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044C
    \u043A \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0443 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    3\u0413 \u0432 \u0432\u0430\u0433\u043E\u043D\u0435 \u21163."
  _scenarioCaption: "\u041E \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0438"
  _controlsCaption: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  _pauseCaption: "\u041F\u0430\u0443\u0437\u0430"
  _startLabel: "\u0412 \u043F\u0443\u0442\u044C"
  _resumeText: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
  _guideBeforeStart: "\u0418\u0434\u0438\u0442\u0435 \u043F\u043E <color=#FAC738>\u0436\u0451\u043B\u0442\u043E\u0439
    \u0441\u0442\u0440\u0435\u043B\u043A\u0435</color> \u043D\u0430 \u043F\u043E\u043B\u0443:
    \u043E\u043D\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442 \u043A \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0443,
    \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
    \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0439. \u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435,
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u043D\u0435\u0433\u043E
    \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 E."
  _guideRunning: "<color=#FAC738>\u0416\u0451\u043B\u0442\u0430\u044F \u0441\u0442\u0440\u0435\u043B\u043A\u0430</color>
    \u043D\u0430 \u043F\u043E\u043B\u0443 \u0432\u0435\u0434\u0451\u0442 \u043A \u0442\u0435\u043A\u0443\u0449\u0435\u0439
    \u0446\u0435\u043B\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u044F. G \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u0442
    \u0446\u0435\u043B\u044C \u0438\u043B\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442
    \u0441\u0442\u0440\u0435\u043B\u043A\u0443."
